---
/**
 * The CTA arrow.
 *
 * Sixteen copies of this path were inlined across pruefanfrage.de alone. Kept
 * here so every kit block and every consuming site points the same direction
 * with the same weight.
 */
interface Props {
  class?: string;
}
const { class: className = 'h-4 w-4' } = Astro.props;
---
<svg class={className} viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
  <path
    fill-rule="evenodd"
    d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
    clip-rule="evenodd"
  />
</svg>
