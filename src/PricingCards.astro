---
/**
 * Tiers as column cards — one card per tier, features listed inside.
 *
 * The hairline grid is drawn with `gap: 1px` over a line-coloured background
 * rather than per-card borders, so adjacent cards share a single rule instead
 * of doubling it.
 *
 * See `PricingMatrix` for the row-wise comparison layout, and `lib/pricing` for
 * why both exist over one shared `Tier` type.
 */
import { assertSingleHighlight, type Tier } from './lib/pricing';

interface Props {
  tiers: Tier[];
  /** Rendered under the grid, e.g. VAT wording. */
  footnote?: string;
}

const { tiers, footnote } = Astro.props;
assertSingleHighlight(tiers);
---
<div class="df-tiers" data-count={tiers.length}>
  {tiers.map((tier) => (
    <div class="df-tier" data-highlight={tier.highlight ? 'true' : 'false'} id={tier.id}>
      <p class="df-tier__name">{tier.name}</p>
      {tier.tagline && <p class="df-tier__tagline">{tier.tagline}</p>}

      <p class="df-tier__price">{tier.price}</p>
      {tier.priceNote && <p class="df-tier__price-note">{tier.priceNote}</p>}

      {tier.features && tier.features.length > 0 && (
        <ul class="df-tier__features">
          {tier.features.map((f) => (
            <li><span class="df-tier__bullet"></span>{f}</li>
          ))}
        </ul>
      )}

      {tier.cta && (
        <a href={tier.cta.href} data-cta={tier.id} class="df-tier__cta">
          {tier.cta.label}
        </a>
      )}
    </div>
  ))}
</div>
{footnote && <p class="df-tiers__footnote">{footnote}</p>}

<style>
  .df-tiers {
    display: grid;
    gap: 1px;
    background: var(--color-line);
    border: 1.5px solid var(--color-line);
  }
  @media (min-width: 768px) {
    .df-tiers[data-count='2'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .df-tiers[data-count='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .df-tiers[data-count='4'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .df-tiers[data-count='4'] { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .df-tier {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: var(--color-surface, var(--color-canvas));
    scroll-margin-top: 5rem;
  }
  @media (min-width: 640px) {
    .df-tier { padding: 1.75rem; }
  }
  /* The tier you want chosen inverts, so it reads first at a glance. */
  .df-tier[data-highlight='true'] {
    background: var(--color-ink);
    color: var(--color-canvas);
  }

  .df-tier__name {
    font-family: var(--font-display, system-ui, sans-serif);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-ink);
  }
  .df-tier__tagline {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  .df-tier__price {
    margin-top: 1.25rem;
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: 2rem;
    font-weight: 900;
    line-height: 1;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .df-tier__price-note {
    margin-top: 0.375rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }

  .df-tier[data-highlight='true'] :is(.df-tier__name, .df-tier__price) { color: var(--color-canvas); }
  .df-tier[data-highlight='true'] :is(.df-tier__tagline, .df-tier__price-note, .df-tier__features) {
    color: color-mix(in srgb, var(--color-canvas) 75%, transparent);
  }

  .df-tier__features {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    flex-grow: 1;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  .df-tier__features li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin-top: 0.625rem;
  }
  .df-tier__bullet {
    margin-top: 0.5em;
    height: 0.375rem;
    width: 0.375rem;
    flex-shrink: 0;
    background: var(--color-accent);
  }
  .df-tier[data-highlight='true'] .df-tier__bullet { background: var(--color-canvas); }

  .df-tier__cta {
    margin-top: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-canvas);
    background: var(--color-accent);
    transition: background-color 0.15s;
  }
  .df-tier__cta:hover { background: color-mix(in srgb, var(--color-accent) 88%, black); }
  .df-tier[data-highlight='true'] .df-tier__cta {
    color: var(--color-ink);
    background: var(--color-canvas);
  }
  .df-tier[data-highlight='true'] .df-tier__cta:hover {
    background: color-mix(in srgb, var(--color-canvas) 88%, black);
  }

  .df-tiers__footnote {
    margin-top: 1rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }
</style>
