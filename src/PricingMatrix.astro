---
/**
 * Tiers as a row-wise comparison matrix.
 *
 * Replaces independent cards when the ladder has enough rungs that a buyer
 * cannot compare like-for-like: here every row is answered by every tier,
 * including with an em dash, which is itself information.
 *
 * `values` is keyed by `Tier.id`, so renaming a tier surfaces as a type error
 * rather than a silently blank column.
 *
 * The table is its own scroll container (`display: block; overflow-x: auto`) so
 * a five-column ladder never forces the page body to scroll sideways on a
 * phone — the widest column scrolls within the table instead.
 */
import { assertSingleHighlight, type CompareRow, type Tier } from './lib/pricing';

interface Props {
  tiers: Tier[];
  rows: CompareRow[];
  footnote?: string;
  /**
   * Screen-reader caption. A comparison table is meaningless to a screen reader
   * without one, so this is required rather than optional.
   */
  caption: string;
  /** Header of the first column. */
  rowHeader?: string;
}

const { tiers, rows, footnote, caption, rowHeader = 'Feature' } = Astro.props;
assertSingleHighlight(tiers);

const cell = (row: CompareRow, tier: Tier) => {
  const v = row.values[tier.id];
  if (v === true) return '✓';
  if (v === false || v === undefined || v === '') return '—';
  return v;
};
---
<div class="df-matrix__scroll">
  <table class="df-matrix">
    <caption class="df-matrix__caption">{caption}</caption>
    <thead>
      <tr>
        <th scope="col"><span class="df-matrix__corner">{rowHeader}</span></th>
        {tiers.map((tier) => (
          <th scope="col" id={tier.id} data-highlight={tier.highlight ? 'true' : 'false'}>
            {tier.badge && <span class="df-matrix__badge">{tier.badge}</span>}
            <span class="df-matrix__name">{tier.name}</span>
            <span class="df-matrix__price">{tier.price}</span>
            {tier.priceNote && <span class="df-matrix__price-note">{tier.priceNote}</span>}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          {tiers.map((tier) => (
            <td data-highlight={tier.highlight ? 'true' : 'false'}>{cell(row, tier)}</td>
          ))}
        </tr>
      ))}
    </tbody>
    <tfoot>
      <tr>
        <td></td>
        {tiers.map((tier) => (
          <td data-highlight={tier.highlight ? 'true' : 'false'}>
            {tier.cta && (
              <a href={tier.cta.href} data-cta={tier.id} class="df-matrix__cta">{tier.cta.label}</a>
            )}
          </td>
        ))}
      </tr>
    </tfoot>
  </table>
</div>
{footnote && <p class="df-matrix__footnote">{footnote}</p>}

<style>
  .df-matrix__scroll {
    display: block;
    width: 100%;
    overflow-x: auto;
  }
  .df-matrix {
    width: 100%;
    border-collapse: collapse;
    border: 1.5px solid var(--color-ink);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .df-matrix thead th {
    padding: 1rem;
    text-align: left;
    vertical-align: bottom;
    background: var(--color-canvas-deep);
    border-bottom: 1.5px solid var(--color-ink);
    scroll-margin-top: 5rem;
  }
  .df-matrix thead th[data-highlight='true'] {
    background: var(--color-ink);
    color: var(--color-canvas);
  }
  /* Visually hidden, still announced. */
  .df-matrix__caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .df-matrix__badge {
    display: block;
    margin-bottom: 0.375rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .df-matrix thead th[data-highlight='true'] .df-matrix__badge {
    color: var(--color-canvas);
  }

  .df-matrix__corner {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-faint);
  }
  .df-matrix__name {
    display: block;
    font-family: var(--font-display, system-ui, sans-serif);
    font-weight: 700;
    line-height: 1.3;
  }
  .df-matrix__price {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .df-matrix__price-note {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--color-ink-faint);
  }
  .df-matrix thead th[data-highlight='true'] .df-matrix__price-note {
    color: color-mix(in srgb, var(--color-canvas) 70%, transparent);
  }

  .df-matrix tbody th {
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    color: var(--color-ink);
    vertical-align: top;
    min-width: 12rem;
  }
  .df-matrix td {
    padding: 0.75rem 1rem;
    vertical-align: top;
    color: var(--color-ink-soft);
    min-width: 9rem;
  }
  .df-matrix tbody tr + tr :is(th, td) {
    border-top: 1px solid var(--color-line);
  }
  .df-matrix tbody tr:nth-child(even) :is(th, td) {
    background: color-mix(in srgb, var(--color-canvas-deep) 55%, transparent);
  }
  /* The highlighted column stays tinted through the zebra striping. */
  .df-matrix td[data-highlight='true'] {
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
    color: var(--color-ink);
  }

  .df-matrix tfoot td {
    padding: 1rem;
    border-top: 1.5px solid var(--color-ink);
  }
  .df-matrix__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--color-canvas);
    background: var(--color-accent);
    transition: background-color 0.15s;
  }
  .df-matrix__cta:hover { background: color-mix(in srgb, var(--color-accent) 88%, black); }

  .df-matrix__footnote {
    margin-top: 1rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }
</style>
