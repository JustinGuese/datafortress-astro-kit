---
/**
 * Objection handling, as a native `<details>` accordion plus FAQPage JSON-LD.
 *
 * The two halves are emitted from the same array on purpose. Google issues
 * manual actions for FAQ markup whose answers are not visible on the page, and
 * the reliable way to prevent that is to make it impossible to write one
 * without the other.
 *
 * `<details>`/`<summary>` rather than JS: it is keyboard accessible, findable
 * by in-page search in modern browsers, and works before hydration.
 */
import { faqSchema } from './lib/seo';

interface Props {
  items: { q: string; a: string }[];
  /** Index left open on load. `-1` opens none. */
  openIndex?: number;
  /** Emit the FAQPage JSON-LD. Turn off if the page already has one. */
  schema?: boolean;
}

const { items, openIndex = 0, schema = true } = Astro.props;
---
{schema && items.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema(items))} is:inline />
)}

<div class="df-faq">
  {items.map((item, i) => (
    <details open={i === openIndex}>
      <summary>
        <span>{item.q}</span>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
        </svg>
      </summary>
      <div class="df-faq__answer"><p>{item.a}</p></div>
    </details>
  ))}
</div>

<style>
  .df-faq {
    border: 1.5px solid var(--color-ink);
  }
  .df-faq details + details {
    border-top: 1px solid var(--color-line);
  }

  .df-faq summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display, system-ui, sans-serif);
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-ink);
  }
  /* Safari draws its own triangle without this. */
  .df-faq summary::-webkit-details-marker {
    display: none;
  }
  .df-faq summary:hover {
    background: var(--color-canvas-deep);
  }
  .df-faq summary svg {
    height: 1.25rem;
    width: 1.25rem;
    flex-shrink: 0;
    margin-top: 0.125rem;
    color: var(--color-accent);
    transition: transform 0.2s;
  }
  .df-faq details[open] summary svg {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .df-faq summary svg { transition: none; }
  }

  .df-faq__answer {
    padding: 0 1.5rem 1.25rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }
</style>
