---
/**
 * The full-width closing CTA — the dark band at the foot of a page that catches
 * a reader who scrolled the whole thing and is now looking for the next step.
 *
 * Unlike `HeroBlock` this one *does* take a secondary CTA. At the top of a page
 * a second option splits attention before intent exists; down here the reader
 * has already self-selected, and the two live choices are genuinely "buy" and
 * "see what it costs". Keep the secondary a quieter outline, never a second
 * filled button.
 *
 * `data-cta` is stamped from each CTA's `track` value, so the delegated listener
 * in `FunnelTracking` picks these up with no per-page wiring.
 */
import SectionHeader from './SectionHeader.astro';

interface Props {
  title: string;
  eyebrow?: string;
  body?: string;
  cta: { label: string; href: string; track: string };
  secondary?: { label: string; href: string; track: string };
  align?: 'start' | 'center';
  id?: string;
  class?: string;
}

const { title, eyebrow, body, cta, secondary, align = 'center', id, class: className = '' } = Astro.props;
---
<section class:list={['df-band', className]} id={id} data-align={align}>
  <div class="df-band__inner">
    <SectionHeader title={title} eyebrow={eyebrow} lead={body} tone="canvas" align={align} size="md">
      <slot name="eyebrow" slot="eyebrow" />
    </SectionHeader>

    <div class="df-band__actions">
      <a href={cta.href} data-cta={cta.track} class="df-band__primary">
        {cta.label}
        <slot name="cta-icon" />
      </a>
      {secondary && (
        <a href={secondary.href} data-cta={secondary.track} class="df-band__secondary">
          {secondary.label}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .df-band {
    background: var(--color-ink);
    padding: 4rem 1rem;
  }
  @media (min-width: 640px) {
    .df-band { padding-inline: 1.5rem; }
  }
  .df-band__inner {
    max-width: 56rem;
    margin-inline: auto;
  }

  .df-band__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }
  @media (min-width: 640px) {
    .df-band__actions { flex-direction: row; }
  }
  .df-band[data-align='center'] .df-band__actions { justify-content: center; }

  .df-band__primary,
  .df-band__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-canvas);
    transition: background-color 0.15s, border-color 0.15s;
  }
  .df-band__primary { background: var(--color-accent); }
  .df-band__primary:hover { background: color-mix(in srgb, var(--color-accent) 88%, black); }

  .df-band__secondary {
    border: 1.5px solid color-mix(in srgb, var(--color-canvas) 30%, transparent);
  }
  .df-band__secondary:hover { border-color: var(--color-canvas); }
</style>
