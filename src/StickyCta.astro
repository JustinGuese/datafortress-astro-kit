---
/**
 * Mobile sticky footer CTA.
 *
 * Appears once the visitor has scrolled past `showAfter`, and hides itself
 * whenever a real in-page CTA is on screen — so it never competes with the
 * section it duplicates. Pass the ids of those sections as `hideNear`.
 *
 * Carries `data-cta` so `FunnelTracking.astro` tracks it like any other CTA.
 * Scoped styles, not Tailwind utilities — see the note in CookieBanner.astro.
 */
import { defaultStickyCtaStrings, type StickyCtaStrings } from './lib/strings';

interface Props {
  href: string;
  /** Value reported to analytics as the CTA label. */
  cta: string;
  strings?: Partial<StickyCtaStrings>;
  /** Scroll depth in px before the bar may appear. */
  showAfter?: number;
  /** Element ids whose visibility suppresses the bar. */
  hideNear?: string[];
}

const {
  href,
  cta,
  strings,
  showAfter = 400,
  hideNear = [],
} = Astro.props;
const t = { ...defaultStickyCtaStrings, ...strings };
---
<div id="df-sticky-cta" class="df-sticky" aria-hidden="true">
  <div class="df-sticky__inner">
    {t.note && <p class="df-sticky__note">{t.note}</p>}
    <a href={href} class="df-sticky__btn" data-cta={cta}>
      {t.ctaLabel}
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/>
      </svg>
    </a>
  </div>
</div>

<style>
  .df-sticky {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 40;
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s, opacity 0.3s;
  }
  .df-sticky.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  @media (min-width: 768px) {
    .df-sticky { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .df-sticky { transition: none; }
  }

  .df-sticky__inner {
    background: color-mix(in srgb, var(--color-canvas) 95%, transparent);
    backdrop-filter: blur(8px);
    border-top: 1.5px solid var(--color-line);
    box-shadow: 0 -4px 20px color-mix(in srgb, var(--color-ink) 12%, transparent);
    padding: 0.75rem 1rem calc(env(safe-area-inset-bottom) + 0.75rem);
  }

  .df-sticky__note {
    margin-bottom: 0.5rem;
    text-align: center;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.68rem;
    color: var(--color-ink-faint);
  }

  .df-sticky__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.875rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-canvas);
    background: var(--color-accent);
    transition: transform 0.1s;
  }
  .df-sticky__btn:active { transform: scale(0.98); }
  .df-sticky__btn svg { height: 1rem; width: 1rem; }
</style>

<script is:inline define:vars={{ showAfter, hideNear }}>
  (() => {
    function init() {
      const bar = document.getElementById('df-sticky-cta');
      if (!bar) return;

      const show = () => {
        bar.classList.add('is-visible');
        bar.setAttribute('aria-hidden', 'false');
      };
      const hide = () => {
        bar.classList.remove('is-visible');
        bar.setAttribute('aria-hidden', 'true');
      };

      const anchors = hideNear
        .map((id) => document.getElementById(id))
        .filter(Boolean);

      if ('IntersectionObserver' in window && anchors.length) {
        const onScreen = new Set();
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) onScreen.add(e.target);
              else onScreen.delete(e.target);
            });
            if (window.scrollY > showAfter && onScreen.size === 0) show();
            else hide();
          },
          { threshold: 0.05 },
        );
        anchors.forEach((el) => io.observe(el));
        window.addEventListener(
          'scroll',
          () => {
            if (window.scrollY > showAfter && onScreen.size === 0) show();
            else if (window.scrollY <= showAfter) hide();
          },
          { passive: true },
        );
      } else {
        window.addEventListener(
          'scroll',
          () => { if (window.scrollY > showAfter) show(); else hide(); },
          { passive: true },
        );
      }
    }

    init();
    document.addEventListener('astro:after-swap', init);
  })();
</script>
