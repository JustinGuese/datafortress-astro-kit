{
  "name": "@justinguese/astro-kit",
  "type": "module",
  "version": "0.6.0",
  "description": "Consent-gated analytics, first-touch attribution, SEO head and funnel tracking for Astro landing pages. The invisible correctness layer — deliberately contains no section components.",
  "author": "Justin Güse",
  "license": "MIT",
  "homepage": "https://github.com/JustinGuese/datafortress-astro-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustinGuese/datafortress-astro-kit.git"
  },
  "bugs": {
    "url": "https://github.com/JustinGuese/datafortress-astro-kit/issues"
  },
  "keywords": [
    "astro",
    "astro-component",
    "withastro",
    "consent-mode",
    "gdpr",
    "dsgvo",
    "analytics",
    "attribution",
    "landing-page",
    "seo"
  ],
  "files": [
    "src",
    "styles",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": null,
    "./package.json": "./package.json",
    "./styles/*.css": "./styles/*.css",
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./*.astro": "./src/*.astro"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.astro"
  ],
  "peerDependencies": {
    "astro": "^7.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "npm run test:starter",
    "test:starter": "node scripts/verify-starter.mjs",
    "prepublishOnly": "node scripts/check-publish.mjs"
  }
}
